# Copie este arquivo para backend/.env antes de iniciar a API.
# As credenciais abaixo precisam ser compatíveis com o docker-compose.yml.
POSTGRES_DB=catalogo_produtos
POSTGRES_USER=catalogo_user
POSTGRES_PASSWORD=catalogo_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa usada pelo SQLAlchemy. O driver psycopg é indicado no prefixo.
DATABASE_URL=postgresql+psycopg://catalogo_user:catalogo_password@localhost:5432/catalogo_produtos

# Origem do frontend durante o desenvolvimento. Ajuste se usar outra porta.
FRONTEND_ORIGIN=http://localhost:5500

# Credenciais do usuário de streaming replication (Trabalho 2). Usadas apenas
# pelo container postgres-replica para clonar e sincronizar com o primário.
# Se você mudar esses valores, atualize também o mesmo par em docker-compose.yml.
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_password
